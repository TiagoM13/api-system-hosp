{
  "name": "system-hosp",
  "version": "1.0.0",
  "main": "dist/src/app/infra/http/server.js",
  "prisma": {
    "schema": "./src/app/infra/prisma/schema.prisma",
    "migrateOutput": "./src/app/infra/prisma/migrations"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node dist/src/app/infra/http/server.js",
    "dev": "tsx --watch ./src/app/infra/http/server.ts",
    "build": "swc src -d dist",
    "lint": "eslint src",
    "prettier": "prettier --check ./",
    "prettier:fix": "prettier --check --write ./",
    "seed": "tsx ./src/app/infra/prisma/seed.ts",
    "migrate": "prisma migrate deploy",
    "migrate:new": "prisma migrate dev",
    "migrate:generate": "prisma generate",
    "migrate:reset": "prisma migrate reset",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "setup": "npm run docker:up && sleep 5 && npm run migrate:generate && npm run migrate:new",
    "dev:full": "npm run setup && npm run dev"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "API de tests para um Sistema Hospitalar",
  "devDependencies": {
    "@swc/cli": "^0.4.1",
    "@swc/core": "^1.9.3",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.19",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-import-helpers": "^1.3.1",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "strip-ansi": "^7.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.2",
    "@fastify/swagger": "^9.3.0",
    "@fastify/swagger-ui": "^5.0.1",
    "@prisma/client": "^6.1.0",
    "dayjs": "^1.11.13",
    "fastify": "^5.2.0",
    "fastify-bcrypt": "^2.0.0",
    "form-auto-content": "^3.2.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.19",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.4"
  }
}
